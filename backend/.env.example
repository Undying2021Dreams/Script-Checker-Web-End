# Copy to .env and fill in. Never commit the real .env file.

DATABASE_URL=postgresql+psycopg2://webend:webend_dev_only@localhost:5434/webend
REDIS_URL=redis://localhost:6379/0

PUBLIC_BASE_URL=http://localhost:8000
# Where the PDF renderer reaches this app's own static files. Keep it
# internal — it should not go out through a load balancer.
RENDER_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microsoft Entra ID — filled in once the app registration exists (see setup steps)
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=
AZURE_OPENAPI_CLIENT_ID=

# Comma-separated emails that get role="teacher" automatically on first login
TEACHER_EMAILS=

# LLM providers — at least one needed for grading/authoring AI features
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SELF_HOSTED_LLM_URL=

# Override if a provider retires the default model id
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini
# CLAUDE_MODEL=claude-haiku-4-5-20251001
